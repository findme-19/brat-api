{
  "name": "brat-api",
  "version": "1.0.0",
  "description": "Brat text/image/video generator + memegen-compatible meme API with web dashboard",
  "main": "app.js",
  "license": "MIT",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "setup": "bash setup.sh",
    "pm2:start": "pm2 start app.js --name brat",
    "pm2:restart": "pm2 restart brat --update-env",
    "pm2:stop": "pm2 stop brat",
    "pm2:logs": "pm2 logs brat --lines 50"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@napi-rs/canvas": "^1.0.3",
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "js-yaml": "^5.2.2",
    "morgan": "^1.10.0",
    "node-webpmux": "^3.2.1",
    "playwright": "^1.49.1"
  }
}
