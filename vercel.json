{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "site/**/*",
          "public/**/*",
          "bratCanvas.js",
          "memeGen.js"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/app.js" }
  ]
}
